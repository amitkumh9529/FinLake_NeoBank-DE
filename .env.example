# FinLake Environment Configuration Template
# Copy this file to .env for local execution (NEVER commit .env to Git)

FINLAKE_ENV=dev
FINLAKE_CATALOG=finlake_dev

# Core Banking RDBMS Connection (Used locally; in Databricks use Secret Scopes)
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=banking
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=your_secure_password_here

# Storage / Landing Paths (Local fallback or Cloud Volume)
SOURCE_VOLUME_PATH=/Volumes/finlake/source/volume
CHECKPOINT_BASE_PATH=/Volumes/finlake/source/volume/_checkpoints
SCHEMA_BASE_PATH=/Volumes/finlake/source/volume/_schema

# Alerting / Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
ALERT_SENDER_EMAIL=alerts@finlake.internal
ALERT_RECIPIENT_EMAIL=data-eng@finlake.internal
